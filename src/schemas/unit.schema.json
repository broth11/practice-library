{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practice-library.local/schemas/unit.schema.json",
  "title": "Practice Library unit",
  "type": "object",
  "required": ["schemaVersion", "id", "code", "title", "description", "lessons", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "reviewStatus": { "type": "string" },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "intro": { "type": "string" },
          "cedTopics": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "question.schema.json" }
    }
  }
}
