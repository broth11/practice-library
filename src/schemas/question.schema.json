{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practice-library.local/schemas/question.schema.json",
  "title": "Practice Library question",
  "type": "object",
  "required": ["id", "lesson", "archetype", "scenario", "prompt", "choices", "answer", "solution"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "lesson": { "type": "string" },
    "archetype": { "type": "string", "description": "Must be registered in the course's archetypes.json." },
    "variant": { "type": ["string", "null"], "description": "Card variant id (V#), or null when no primary evidence supports one." },
    "scenario": { "type": "string" },
    "prompt": { "type": "string" },
    "choices": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/choice" } },
    "answer": { "enum": ["A", "B", "C", "D"] },
    "stimulus": { "$ref": "#/$defs/stimulus" },
    "solutionStimulus": { "$ref": "#/$defs/stimulus" },
    "solution": {
      "type": "object",
      "required": ["steps", "warning"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/math" }] }
        },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "calculator": { "type": "object" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "choice": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type", "rows"],
          "properties": {
            "type": { "const": "stem-and-leaf" },
            "rows": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["stem", "leaves"],
                "properties": {
                  "stem": { "type": "string", "pattern": "^[0-9]+$" },
                  "leaves": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]$" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "math": {
      "type": "object",
      "description": "Explicit TeX rendered by KaTeX. Use display for multi-line work, prominent fractions, matrices, and calculus.",
      "required": ["type", "mode", "tex"],
      "properties": {
        "type": { "const": "math" },
        "mode": { "enum": ["inline", "display"] },
        "tex": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stimulus": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "description": "Generated figure. Its source is an entry in src/diagrams/<course>.json.",
          "required": ["type", "src", "alt", "width", "height"],
          "properties": {
            "type": { "const": "image" },
            "src": { "type": "string", "pattern": "^assets/[a-z0-9-]+\\.svg$" },
            "alt": { "type": "string", "minLength": 20 },
            "caption": { "type": "string" },
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["type", "headers", "rows"],
          "properties": {
            "type": { "const": "table" },
            "caption": { "type": "string" },
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number"] } } }
          }
        },
        {
          "type": "object",
          "description": "Authored HTML. Allowed but discouraged; prefer table or image.",
          "required": ["type", "html"],
          "properties": { "type": { "const": "html" }, "html": { "type": "string" } }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "description": "Unknown historical fields stay null. Never infer them from the rendered card.",
      "properties": {
        "optionRoles": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^(KEY|[DT][0-9]+)$" }, "minItems": 4, "maxItems": 4 },
        "keyBuild": { "type": ["string", "null"] },
        "variant": { "type": ["string", "null"] },
        "extensions": { "type": "array", "description": "Departures from the card's observed evidence, including builds outside a variant's observed_builds." },
        "sourceReview": { "type": ["object", "null"] },
        "original": { "type": ["object", "null"], "description": "Authoring record carried from the source package (basis, card_exemplars, ced, human_verified)." },
        "lengthReview": { "type": "array" },
        "boundsCheck": { "type": "object" },
        "migratedFrom": { "type": "object", "description": "Where this item's text was migrated from: a git commit and file, or a named local package." }
      }
    }
  }
}
